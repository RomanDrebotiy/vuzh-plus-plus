FUNC factorial n
SUB n 1 t0
GOTOIFNOT t0 7
SUB n 1 n1
CALL factorial n1 x
MUL n x res
RETURN res
RETURN 1
ENDFUNC
FUNC factorial_sequence start end
SUB start end t0
GOTOIFNOT t0 14
TEXT end_number_should_be_greater_than_start_number
RETURN
COPY start i
SUB end i t0
GOTOIFNOT t0 20
CALL factorial i a#i
ADD i 1 i
GOTO 15
RETURN a
ENDFUNC
FUNC print_res start end results
LEN results l
TEXT printing_initialized_array_length
WRITE l
TEXT printing_sequence_of_factorials
COPY start i
SUB end i t0
GOTOIFNOT t0 33
WRITE results#i
ADD i 1 i
GOTO 28
ENDFUNC
FUNC test1 
READ start
READ end
CALL factorial_sequence start end results
GOTOIFNOT results 42
CALL print_res start end results _
TEXT printing_second_time_other_way
WRITE results
ENDFUNC
FUNC test2 
TEXT just_testing_expression_optimization
COPY 1 a
COPY 2 b
COPY 3 c
COPY 4 d
MUL 2 a t1
ADD a d t0
DIV c t0 t0
ADD b t0 t0
MUL 5 t0 t0
ADD t1 t0 x
WRITE x
ENDFUNC
FUNC test_matrix 
COPY 1 i
SUB 3 i t0
GOTOIFNOT t0 69
COPY 1 j
SUB 3 j t0
GOTOIFNOT t0 67
ADD i j a#i:j
ADD j 1 j
GOTO 62
ADD i 1 i
GOTO 59
RETURN a
ENDFUNC
FUNC test3 
CALL test_matrix  res
TEXT testing_2D_arrays
WRITE res
FWRITE res .\examples\test.txt
TEXT output_dimensions_lengths
LEN res l
WRITE l
ENDFUNC
FUNC test4 
TEXT reading_matrix_from_file
FREAD arr .\examples\test.txt
WRITE arr
TEXT testing_element_value_at_position_2_3
WRITE arr#2:3
ENDFUNC
FUNC test5 
TEXT matrix_multiplication_test
FREAD m1 .\examples\matr1.txt
FREAD m2 .\examples\matr2.txt
LEN m1 dim1
LEN m2 dim2
TEXT matr1_dimenstions
WRITE dim1
TEXT matr2_dimenstions
WRITE dim2
TEXT matr1_elements
WRITE m1
TEXT matr2_elements
WRITE m2
COPY 1 i
SUB dim1#1 i t0
GOTOIFNOT t0 119
COPY 1 j
SUB dim2#2 j t0
GOTOIFNOT t0 117
COPY 1 k
COPY 0 res#i:j
SUB dim1#2 k t0
GOTOIFNOT t0 115
MUL m1#i:k m2#k:j t0
ADD res#i:j t0 res#i:j
ADD k 1 k
GOTO 109
ADD j 1 j
GOTO 105
ADD i 1 i
GOTO 102
TEXT result
WRITE res
FWRITE res .\examples\matr_mult.txt
ENDFUNC
FUNC main 
CALL test1  _
CALL test2  _
CALL test3  _
CALL test4  _
CALL test5  _
TEXT Done!
ENDFUNC