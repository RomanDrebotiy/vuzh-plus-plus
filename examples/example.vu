func> factorial(n) {
    if[n-1]{
        n1 = n-1;
        x = call> factorial(n1);
        res = n * x;
        return> res;
    }
    return> 1;
}

func> factorial_sequence(start, end) {
    if[start-end]{
        text> end_number_should_be_greater_than_start_number;
        return>;
    }
    i = start;
    while[end - i]{
        a#i = call> factorial(i);
        i = i + 1;
    }
    return> a;
}

func> print_res(start, end, results) {
    // just testing arrays
    l = len> results;
    text> printing_initialized_array_length;
    write> l;
    text> printing_sequence_of_factorials;
    i = start;
    while[end - i]{
        write> results#i;
        i = i + 1;
    }
}

func> test1() {
    read> start;
    read> end;
    results = call> factorial_sequence(start, end);
    if[results] {
        call> print_res(start, end, results);
        text> printing_second_time_other_way;
        write> results;
    }
}

func> test2() {
    text> just_testing_expression_optimization;
    a = 1;
    b = 2;
    c = 3;
    d = 4;
    x = 2*a+5*(b+c/(a+d));
    write> x;
}

func> test_matrix() {
    i = 1;
    while[3-i] {
        j = 1;
        while[3-j] {
            a#i:j = i + j;
            j = j + 1;
        }
        i = i + 1;
    }
    return> a;
}

func> test3() {
    res = call> test_matrix();
    text> testing_2D_arrays;
    write> res;
    // Writing matrix also to file.
    // Always use Windows-style separator!
    fwrite> res, .\examples\test.txt;
    text> output_dimensions_lengths;
    l = len> res;
    write> l;
}

func> test4() {
    text> reading_matrix_from_file;
    fread> arr, .\examples\test.txt;
    write> arr;
    text> testing_element_value_at_position_2_3;
    write> arr#2:3;
}

func> main() {
    call> test1();
    call> test2();
    call> test3();
    call> test4();
    text> Done!;
}

